<UserControl x:Class="YoYo.ToolkitSample.Views.NotifiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YoYo.ToolkitSample.Converters"
             FontFamily="{DynamicResource Sample.FontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <conv:ResourceKeyToGeometryConverter x:Key="IconKey" />
    </UserControl.Resources>

    <StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 四级按钮 ============ -->
            <Border Grid.Column="0" Style="{StaticResource Sample.Card}" Padding="14,12" Margin="0,0,10,0"
                    VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="TMessageBox · 四级" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="Notifies" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>

                    <TextBlock Style="{StaticResource Sample.Muted}" Margin="0,0,0,12"
                               Text="不依赖系统 MessageBox——外观由宿主注册的窗口决定。点一下看真实模态。" />

                    <ItemsControl ItemsSource="{Binding Levels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Sample.Btn}" Height="52" Margin="0,0,0,9"
                                        Padding="10,0" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.ShowCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7"
                                                Background="{DynamicResource Sample.Surface3}"
                                                VerticalAlignment="Center">
                                            <Path Data="{Binding IconKey, Converter={StaticResource IconKey}}"
                                                  Width="13" Height="13" Stretch="Uniform"
                                                  Stroke="{DynamicResource Sample.Ink2}" StrokeThickness="1.9"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  StrokeStartLineCap="Round" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Sample.Ink}" />
                                            <TextBlock Text="{Binding LevelName}"
                                                       Style="{StaticResource Sample.Kicker}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,1,0,0"
                            Margin="0,3,0,9" />
                    <Grid>
                        <TextBlock Text="ShowMsg(caption, msg, level)" Style="{StaticResource Sample.Kicker}" />
                        <TextBlock Text="返回 TMessageBoxResult" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 返回值 ============ -->
            <Border Grid.Column="1" Style="{StaticResource Sample.Card}" Padding="14,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="返回值" Style="{StaticResource Sample.CardTitle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="TMessageBoxResult" Style="{StaticResource Sample.Kicker}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Sample.Btn.Ghost}" Content="清空" Height="21"
                                    Command="{Binding ClearCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource Sample.Surface2}"
                            BorderBrush="{DynamicResource Sample.Line}" BorderThickness="1"
                            CornerRadius="6" Height="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="9,7">
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Time}"
                                                       FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                                       FontSize="11.5" Foreground="{DynamicResource Sample.Ink3}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Level}"
                                                       FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                                       FontSize="11.5" Foreground="{DynamicResource Sample.Ink2}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Result}"
                                                       FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                                       FontSize="11.5" Foreground="{DynamicResource Sample.Accent}"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="OK / Cancel / No / Close / None" Style="{StaticResource Sample.Kicker}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 接入方式 ============ -->
        <TextBlock Text="接入方式" Style="{StaticResource Sample.SecTitle}" Margin="0,20,0,0" />
        <Border BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,0,0,1" Margin="0,7,0,11"
                Height="1" />
        <TextBlock Text="启动时注册一次" Style="{StaticResource Sample.Kicker}" Margin="0,-9,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Sample.Card}" Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="注册弹窗实现" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="C#" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>
                    <Border Style="{StaticResource Sample.CodeBlock}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Foreground="{DynamicResource Sample.Ink3}"
                                       Text="// 构造函数签名固定为 (caption, msg, level)" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="TMessageBox.Init(typeof(MyMessageDialog));" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Margin="0,6,0,0"
                                       Text="var r = TMessageBox.ShowMsg(" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="    &quot;开始运行&quot;," />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="    &quot;确认以当前参数启动采集？&quot;," />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="    TMessageBox.MessageLevel.Question);" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Margin="0,6,0,0"
                                       Text="if (r == TMessageBoxResult.OK) StartRun();" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Sample.Card}" Padding="14,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="自定义窗口" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="BaseMessageDialog" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>
                    <Border Style="{StaticResource Sample.CodeBlock}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Foreground="{DynamicResource Sample.Ink3}"
                                       Text="// 外观完全由你画；关闭前把结果写回" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="public partial class MyMessageDialog" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="    : BaseMessageDialog" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Text="{}{" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="    public MyMessageDialog(string caption," />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="        string msg, MessageLevel level)" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="        : base(caption, msg, level) { }" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Margin="0,4,0,0"
                                       Text="    void OnOk(object s, RoutedEventArgs e)" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Text="    {" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="        MessageBoxResult = TMessageBoxResult.OK;" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Text="        Close();" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Text="    }" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Text="}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Sample.Kicker}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="模态：Owner 由 TMessageBox.MessageBoxOwner 指定；示例窗口自绘标题栏与按钮" />
                </StackPanel>
            </Border>
        </Grid>

    </StackPanel>
</UserControl>
