<Application x:Class="YoYo.ToolkitSample.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YoYo.ToolkitSample"
             xmlns:vm="clr-namespace:YoYo.ToolkitSample.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1) 浅色令牌：所有画笔与字号只在这里定义，深色靠同名覆盖 -->
                <ResourceDictionary Source="Themes/Tokens.Light.xaml" />
                <!-- 2) 外壳与通用样式 -->
                <ResourceDictionary Source="Themes/Styles.xaml" />
                <!-- 3) 宿主为 Toolkit 控件补的模板（TreeComboBox / TProgressRing / IconRadioButton …） -->
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- ViewModel 定位器：View 的 DataContext 统一从这里取 -->
            <vm:ViewModelLocator x:Key="locator" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
