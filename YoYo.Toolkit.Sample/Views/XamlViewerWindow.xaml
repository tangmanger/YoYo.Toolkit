<Window x:Class="YoYo.ToolkitSample.Views.XamlViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="控件用法"
        Width="1000" Height="720" MinWidth="680" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Sample.Page}"
        FontFamily="{DynamicResource Sample.FontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!-- 与外壳同一套外框：WindowChrome + DWM 圆角/阴影 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Sample.Page}"
            BorderBrush="{DynamicResource Sample.LineStrong}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- 标题栏（整条可拖拽，按钮需显式放行） -->
            <Grid Grid.Row="0" Background="{DynamicResource Sample.Surface}">
                <Border BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,0,0,1" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="6"
                            Background="{DynamicResource Sample.AccentSoft}">
                        <Path Data="{StaticResource Icon.Code}" Width="12" Height="12" Stretch="Uniform"
                              Stroke="{DynamicResource Sample.Accent}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="控件用法" FontSize="13.5" FontWeight="SemiBold" Margin="9,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Sample.Ink}" />
                    <Border Style="{StaticResource Sample.Chip}" Margin="9,0,0,0">
                        <TextBlock Text="一个控件 · 最小可复制片段" Style="{StaticResource Sample.ChipText}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button x:Name="CopyButton" Style="{StaticResource Sample.WinBtn}" Click="OnCopy"
                            ToolTip="复制当前控件的全部片段到剪贴板"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Copy}" Width="11" Height="11" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" />
                            <TextBlock x:Name="CopyLabel" Text="复制" FontSize="12.5" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Sample.WinBtn.Close}" Click="OnClose"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource Icon.Close}" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 目录 + 片段 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="272" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Sample.Surface}"
                        BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="控件目录" Style="{StaticResource Sample.Kicker}"
                                   Margin="14,12,14,8" />

                        <ListBox x:Name="SampleList" Grid.Row="1" Style="{StaticResource Sample.List}"
                                 Margin="8,0,8,10" SelectionChanged="OnSampleChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Badge}" FontSize="11" Margin="0,2,0,0"
                                                   FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                                   Foreground="{DynamicResource Sample.Ink3}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="16,12,16,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 当前控件抬头 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="NameText" Text="控件名" FontSize="18.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Sample.Ink}" />
                                <Border x:Name="BadgeChip" Style="{StaticResource Sample.Chip}" Margin="9,0,0,0">
                                    <TextBlock x:Name="BadgeText" Style="{StaticResource Sample.ChipText}"
                                               Foreground="{DynamicResource Sample.Accent}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SummaryText" Style="{StaticResource Sample.Muted}"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="9"
                            Background="{DynamicResource Sample.Surface2}"
                            BorderBrush="{DynamicResource Sample.Line}" BorderThickness="1">
                        <RichTextBox x:Name="CodeHost"
                                     IsReadOnly="True" IsUndoEnabled="False"
                                     BorderThickness="0" Background="Transparent"
                                     Padding="14,12,14,16"
                                     FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="13"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     SelectionBrush="{DynamicResource Sample.AccentSoft}" />
                    </Border>
                </Grid>
            </Grid>

            <!-- 状态栏 -->
            <Grid Grid.Row="2" Margin="14,0">
                <TextBlock x:Name="HintText" Text="" VerticalAlignment="Center"
                           FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="11.5"
                           Foreground="{DynamicResource Sample.Ink3}" />
                <TextBlock Text="F12 打开 · Esc 关闭 · 选中代码可局部复制" HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="11.5"
                           Foreground="{DynamicResource Sample.Ink3}" />
            </Grid>
        </Grid>
    </Border>
</Window>
