<UserControl x:Class="YoYo.ToolkitSample.Views.NetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YoYo.ToolkitSample.Converters"
             FontFamily="{DynamicResource Sample.FontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左列 ================= -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">

            <!-- 请求表 -->
            <Border Style="{StaticResource Sample.Card}" Padding="0">
                <StackPanel>
                    <Grid Margin="14,11,14,8">
                        <TextBlock Text="BaseRequest 子类" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="Net.Http" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>

                    <Border Style="{StaticResource Sample.TableHead}" BorderThickness="0,1,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="方法" Style="{StaticResource Sample.Kicker}" />
                            <TextBlock Grid.Column="1" Text="BusinessUrl" Style="{StaticResource Sample.Kicker}" />
                            <TextBlock Grid.Column="2" Text="ResponseType" Style="{StaticResource Sample.Kicker}" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Requests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Sample.TableButton}"
                                        Command="{Binding DataContext.SelectCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Padding="5,1"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Sample.AccentSoft}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Method}" Value="GET">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource Sample.OkSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Method}" FontSize="10.5"
                                                       FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                                       Foreground="{DynamicResource Sample.Ink2}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding BusinessUrl}"
                                                   Style="{StaticResource Sample.TableCell}"
                                                   FontFamily="{DynamicResource Sample.MonoFontFamily}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ResponseType}"
                                                   Style="{StaticResource Sample.TableCell}"
                                                   FontFamily="{DynamicResource Sample.MonoFontFamily}" />
                                        <Ellipse Grid.Column="3" Width="9" Height="9" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="Transparent" />
                                                    <Setter Property="Stroke" Value="{DynamicResource Sample.LineStrong}" />
                                                    <Setter Property="StrokeThickness" Value="1.4" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource Sample.Accent}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource Sample.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="14,8,14,9">
                        <TextBlock Text="RootUrl + BusinessUrl" Style="{StaticResource Sample.Kicker}"
                                   VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource Sample.Switch}" Content="本地模拟"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding IsSimulated, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- DoWorkerAsync -->
            <Border Style="{StaticResource Sample.Card}" Padding="14,12" Margin="0,10,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="DoWorkerAsync" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="回调回到 UI 线程" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>

                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Sample.Btn.Primary}" Command="{Binding SendCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Play}" Width="10" Height="10" Stretch="Uniform"
                                          Fill="White" VerticalAlignment="Center" />
                                    <TextBlock Text="发送请求" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding ModeText}" Style="{StaticResource Sample.Kicker}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ElapsedText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="12"
                                   Foreground="{DynamicResource Sample.Ink2}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Stages}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="122" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Sample.Ink2}" />
                                    <Border x:Name="Bar" Grid.Column="1" Height="3" CornerRadius="2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Sample.Track}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Milliseconds}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                               FontSize="11.5" Foreground="{DynamicResource Sample.Ink3}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="Bar" Property="Background"
                                                Value="{DynamicResource Sample.Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,1,0,0"
                            Margin="0,7,0,10" />

                    <TextBlock Text="Response.Data" Style="{StaticResource Sample.FieldLabel}" Margin="0,0,0,5" />
                    <Border Style="{StaticResource Sample.CodeBlock}" MinHeight="96">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="168"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding Payload}" Style="{StaticResource Sample.CodeText}" />
                        </ScrollViewer>
                    </Border>

                    <Border Background="{DynamicResource Sample.ErrSoft}"
                            BorderBrush="{DynamicResource Sample.Err}" BorderThickness="1"
                            CornerRadius="6" Padding="9,6" Margin="0,9,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Bang}" Width="11" Height="11" Stretch="Uniform"
                                  Stroke="{DynamicResource Sample.Err}" StrokeThickness="2"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ErrorText}" Margin="7,0,0,0"
                                       FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="11.5"
                                       Foreground="{DynamicResource Sample.Err}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= 右列 ================= -->
        <StackPanel Grid.Column="1">

            <!-- NetworkPing -->
            <Border Style="{StaticResource Sample.Card}" Padding="14,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="NetworkPing" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="Net.Pings" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Pings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Sample.LineStrong}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource Sample.Ok}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Host}" Margin="8,0,0,0"
                                                   FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                                   FontSize="12.5" Foreground="{DynamicResource Sample.Ink2}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Result}"
                                               FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                               FontSize="12" Foreground="{DynamicResource Sample.Ink3}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource Sample.Btn.Small}" Content="检测连通性"
                            HorizontalAlignment="Left" Margin="0,3,0,0"
                            Command="{Binding PingCommand}" />

                    <Border BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,1,0,0"
                            Margin="0,10,0,8" />
                    <TextBlock Style="{StaticResource Sample.Kicker}" TextWrapping="Wrap"
                               Text="返回 PingReply?，null 即不可达；示例主机含一个 TEST-NET 地址，用来演示失败" />
                </StackPanel>
            </Border>

            <!-- 错误与等待 -->
            <Border Style="{StaticResource Sample.Card}" Padding="14,12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="统一错误出口" Style="{StaticResource Sample.CardTitle}" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,8">
                        <Border Style="{StaticResource Sample.Chip}" Margin="0,0,5,0">
                            <TextBlock Text="request.Error" Style="{StaticResource Sample.ChipText}" />
                        </Border>
                        <Border Style="{StaticResource Sample.Chip}">
                            <TextBlock Text="IsShowProcess" Style="{StaticResource Sample.ChipText}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Sample.Muted}"
                               Text="网络异常、超时、反序列化失败都走同一个事件，不必在每处 catch 里重复弹框。ShowProcess() / CloseProcess() 可在子类里换成自绘的等待层。" />
                </StackPanel>
            </Border>

            <!-- 请求定义 -->
            <Border Style="{StaticResource Sample.Card}" Padding="14,12" Margin="0,10,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="请求定义" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="Net/DemoRequests.cs" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>
                    <Border Style="{StaticResource Sample.CodeBlock}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="public sealed class LoginRequest : DemoRequestBase" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Text="{}{" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="    public override string BusinessUrl" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="        =&gt; &quot;/api/login&quot;;" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Margin="0,3,0,0"
                                       Text="    public override HttpMethodTypes Method" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="        =&gt; HttpMethodTypes.POST;" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Margin="0,3,0,0"
                                       Text="    public override Type ResponseType" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="        =&gt; typeof(LoginResponse);" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Margin="0,3,0,0"
                                       Text="    public override void SerializeObject()" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="        =&gt; Data = JsonSerializer.Serialize(...);" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Text="}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
