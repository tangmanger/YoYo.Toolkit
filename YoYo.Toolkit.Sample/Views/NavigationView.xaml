<UserControl x:Class="YoYo.ToolkitSample.Views.NavigationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Sample.FontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.42*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左列 ================= -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">

            <!-- 时序 -->
            <Border Style="{StaticResource Sample.Card}" Padding="14,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="一次 GoTo 的完整时序" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="GoTo&lt;T&gt;(name, param)" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}"
                                   Foreground="{DynamicResource Sample.Accent}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Stages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Width="118">
                                        <Border x:Name="Dot" Width="22" Height="22" CornerRadius="11"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource Sample.Surface2}"
                                                BorderBrush="{DynamicResource Sample.LineStrong}"
                                                BorderThickness="1">
                                            <TextBlock x:Name="Num" Text="{Binding Ordinal}"
                                                       FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                                       FontSize="11.5" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Sample.Ink3}" />
                                        </Border>
                                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="13"
                                                   FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                                   Margin="0,7,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Sample.Ink2}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Sample.Muted}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Border x:Name="Link" Width="18" Height="2" Margin="0,10,4,0"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Sample.Track}" />
                                </StackPanel>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLit}" Value="True">
                                        <Setter TargetName="Dot" Property="Background"
                                                Value="{DynamicResource Sample.Accent}" />
                                        <Setter TargetName="Dot" Property="BorderBrush"
                                                Value="{DynamicResource Sample.Accent}" />
                                        <Setter TargetName="Num" Property="Foreground" Value="White" />
                                        <Setter TargetName="Title" Property="Foreground"
                                                Value="{DynamicResource Sample.Accent}" />
                                        <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Link" Property="Background"
                                                Value="{DynamicResource Sample.Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,1,0,0" Margin="0,14,0,12" />

                    <TextBlock Text="发起跳转" Style="{StaticResource Sample.FieldLabel}" Margin="0,0,0,7" />
                    <ItemsControl ItemsSource="{Binding Targets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Go" Style="{StaticResource Sample.Btn.Small}" Margin="0,0,6,6"
                                        Content="{Binding Label}"
                                        Command="{Binding DataContext.PlayCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{DynamicResource Sample.Surface2}"
                            BorderBrush="{DynamicResource Sample.Line}" BorderThickness="1"
                            CornerRadius="7" Padding="12,9" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="当前挂载视图" Style="{StaticResource Sample.FieldLabel}" />
                                <TextBlock Text="{Binding MountView}" Style="{StaticResource Sample.KvValue}"
                                           Margin="0,3,0,0" FontFamily="{DynamicResource Sample.MonoFontFamily}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="传入参数" Style="{StaticResource Sample.FieldLabel}" />
                                <TextBlock Text="{Binding MountParam}" Style="{StaticResource Sample.KvValue}"
                                           Margin="0,3,0,0" Foreground="{DynamicResource Sample.Accent}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="VM 类型" Style="{StaticResource Sample.FieldLabel}" />
                                <TextBlock Text="{Binding MountVm}" Style="{StaticResource Sample.KvValue}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 日志 -->
            <Border Style="{StaticResource Sample.Card}" Padding="14,12" Margin="0,10,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="日志" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="LogWrite → 状态栏" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>
                    <Border Background="{DynamicResource Sample.Surface2}" BorderBrush="{DynamicResource Sample.Line}"
                            BorderThickness="1" CornerRadius="6" Height="132">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="9,7">
                            <ItemsControl ItemsSource="{Binding DataContext.Logs, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding Time}" Width="58"
                                                       FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                                       FontSize="11.5" Foreground="{DynamicResource Sample.Ink3}" />
                                            <TextBlock Text="{Binding Message}"
                                                       FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                                       FontSize="11.5" Foreground="{Binding Brush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="NavigationName = &quot;Main&quot; · 日志同时写入状态栏中央"
                               Style="{StaticResource Sample.Kicker}" Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= 右列 ================= -->
        <StackPanel Grid.Column="1">

            <!-- Navigates 表 -->
            <Border Style="{StaticResource Sample.Card}" Padding="0">
                <StackPanel>
                    <Grid Margin="14,11,14,8">
                        <TextBlock Text="Navigates" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="List&lt;NavigateModel&gt;" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>

                    <Border Style="{StaticResource Sample.TableHead}" BorderThickness="0,1,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource Sample.Kicker}" />
                            <TextBlock Grid.Column="1" Text="ViewType" Style="{StaticResource Sample.Kicker}" />
                            <TextBlock Grid.Column="2" Text="VMType" Style="{StaticResource Sample.Kicker}" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Navigates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Sample.TableButton}"
                                        Command="{Binding DataContext.GoToCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding ViewType}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="1.3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Style="{StaticResource Sample.TableCell}"
                                                   Foreground="{DynamicResource Sample.Ink}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ViewType}"
                                                   Style="{StaticResource Sample.TableCell}"
                                                   FontFamily="{DynamicResource Sample.MonoFontFamily}" />
                                        <TextBlock Grid.Column="2" Text="{Binding VmType}"
                                                   Style="{StaticResource Sample.TableCell}"
                                                   FontFamily="{DynamicResource Sample.MonoFontFamily}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="点击任意行 = 一次 GoTo" Style="{StaticResource Sample.Kicker}"
                               Margin="14,8,14,10" />
                </StackPanel>
            </Border>

            <!-- WindowService：真窗口 + 真注册 + 真关闭 -->
            <Border Style="{StaticResource Sample.Card}" Padding="14,12" Margin="0,10,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,9">
                        <TextBlock Text="WindowService" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="IWindowService" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Windows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Sample.Surface2}"
                                        BorderBrush="{DynamicResource Sample.Line}" BorderThickness="1"
                                        CornerRadius="6" Padding="9,6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource Icon.Panel}"
                                              Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{DynamicResource Sample.Ink3}" StrokeThickness="1.7"
                                              VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="{DynamicResource Sample.Ink}" />
                                            <TextBlock Text="{Binding Id}" Style="{StaticResource Sample.Kicker}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="4" Padding="5,1"
                                                VerticalAlignment="Center" Margin="0,0,7,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Sample.OkSoft}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOpen}" Value="False">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource Sample.ErrSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateText}" FontSize="11"
                                                       Foreground="{DynamicResource Sample.Ink2}" />
                                        </Border>
                                        <Button Grid.Column="3" Style="{StaticResource Sample.Btn.Small}"
                                                Content="打开" Height="21" Padding="7,0" Margin="0,0,5,0"
                                                IsEnabled="{Binding CanOpen}"
                                                Command="{Binding DataContext.OpenWindowCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="4" Style="{StaticResource Sample.Btn.Small}"
                                                Content="关闭" Height="21" Padding="7,0"
                                                IsEnabled="{Binding CanCloseNow}"
                                                Command="{Binding DataContext.CloseWindowCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource Sample.Btn.Small}" Height="24" Margin="0,4,0,0"
                            HorizontalAlignment="Left" Padding="9,0"
                            Content="设备线程关 log-viewer"
                            Command="{Binding CloseFromWorkerCommand}" />

                    <TextBlock Text="打开 = RegisterWindow(window, id) + Show()；关闭 = CloseWindow(id)。主窗口不参与关闭，状态由真实窗口的 Closed 事件回写。"
                               Style="{StaticResource Sample.Kicker}" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- VM 生命周期 -->
            <Border Style="{StaticResource Sample.Card}" Padding="14,12" Margin="0,10,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="VM 生命周期" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="Interfaces/Navigations" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>
                    <Border Style="{StaticResource Sample.CodeBlock}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="public sealed class DeviceViewModel" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="    : INavigateIn&lt;string&gt;, INavigateOut" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Text="{}{" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="    public void NavigateIn(string? sn)" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="        =&gt; /* 按 SN 拉配置、开轮询 */;" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Margin="0,4,0,0"
                                       Text="    public void NavigateOut()" />
                            <TextBlock Style="{StaticResource Sample.CodeText}"
                                       Text="        =&gt; /* 停轮询、退订阅 */;" />
                            <TextBlock Style="{StaticResource Sample.CodeText}" Text="}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
