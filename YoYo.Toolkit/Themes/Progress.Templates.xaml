                                    <ScaleTransform x:Name="Petal0" ScaleY="0.42" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="72" />
                            </Grid.RenderTransform>
                            <Ellipse Width="13" Height="34" VerticalAlignment="Top" HorizontalAlignment="Center"
                                     Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                     RenderTransformOrigin="0.5,1">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Petal1" ScaleY="0.42" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="144" />
                            </Grid.RenderTransform>
                            <Ellipse Width="13" Height="34" VerticalAlignment="Top" HorizontalAlignment="Center"
                                     Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                     RenderTransformOrigin="0.5,1">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Petal2" ScaleY="0.42" />
                                </Ellipse.RenderTransform>
