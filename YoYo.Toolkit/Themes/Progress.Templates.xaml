                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <p:ProgressPainter x:Name="BreathPainter" Grid.Column="0"
                               Pattern="Breathing"
                               Accent="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                               Dim="{DynamicResource Progress.Brush.Track}" />

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 23 · 花瓣绽放 -->
    <ControlTemplate x:Key="Progress.Template.Petal.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PetalSpin"
                                             Storyboard.TargetProperty="(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:4"
                                             RepeatBehavior="Forever" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Petal0"
                                                           Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                                           Duration="0:0:1.8"
                                                           RepeatBehavior="Forever">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.42" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.42" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Petal1"
                                                           Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                                           BeginTime="0:0:0.18"
                                                           Duration="0:0:1.8"
                                                           RepeatBehavior="Forever">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.42" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.42" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Petal2"
                                                           Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                                           BeginTime="0:0:0.36"
                                                           Duration="0:0:1.8"
                                                           RepeatBehavior="Forever">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.42" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.42" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Petal3"
                                                           Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                                           BeginTime="0:0:0.54"
                                                           Duration="0:0:1.8"
                                                           RepeatBehavior="Forever">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.42" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.42" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Petal4"
                                                           Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                                           BeginTime="0:0:0.72"
                                                           Duration="0:0:1.8"
                                                           RepeatBehavior="Forever">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.42" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.42" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="120" Height="120">
                    <Grid Width="120" Height="120" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="PetalSpin" />
                        </Grid.RenderTransform>
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Grid.RenderTransform>
                            <Ellipse Width="13" Height="34" VerticalAlignment="Top" HorizontalAlignment="Center"
                                     Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                     RenderTransformOrigin="0.5,1">
