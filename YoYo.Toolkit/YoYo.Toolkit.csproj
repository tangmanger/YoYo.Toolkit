<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net6.0-windows;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>

  <!-- NuGet 打包元数据 -->
  <PropertyGroup>
    <PackageId>YoYo.Toolkit</PackageId>
    <Version>1.0.0</Version>
    <Title>YoYo.Toolkit</Title>
    <Authors>在梦想路上狂奔的蜗牛</Authors>
    <Company>YoYo.Toolkit</Company>
    <Copyright>Copyright (c) 2025 在梦想路上狂奔的蜗牛</Copyright>
    <Description>面向 WPF 桌面应用的轻量工具集：页面导航框架、HTTP 请求基类、20 种动效的进度与流程步骤控件、常用控件与设备/加密工具，适用于上位机、工控、仪器类项目。全部基于原生 WPF 实现，除 System.Management 外无第三方依赖。</Description>
    <PackageTags>wpf;toolkit;navigation;http;progress;loading;spinner;controls;hmi;scada;industrial;winapi;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/tangmanger/YoYo.Toolkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/tangmanger/YoYo.Toolkit</PackageProjectUrl>
    <PackageReleaseNotes>首个正式版本：导航框架、HTTP 请求基类、WPF 控件集、设备信息与加密工具；新增进度控件（20 种不确定动效 + 确定态 + StepTracker 流程步骤条，自带浅/深令牌与可覆盖模板）。</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="Assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Helpers\Attached\" />
    <Folder Include="Transitions\" />
  </ItemGroup>

</Project>
