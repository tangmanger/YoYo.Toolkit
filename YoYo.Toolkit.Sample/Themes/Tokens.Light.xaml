<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        示例程序自身的调色板（浅色）。
        键名刻意与 Progress.Brush.* 对齐，方便对照：Accent / Ink / InkSecondary / InkDim / Track。
        深色不在这里改键，由 Tokens.Dark.xaml 覆盖同名键——模板与样式一行不动。
    -->

    <Color x:Key="Sample.Color.Page">#F2F3F4</Color>
    <Color x:Key="Sample.Color.Surface">#FFFFFF</Color>
    <Color x:Key="Sample.Color.Surface2">#FAFBFB</Color>
    <Color x:Key="Sample.Color.Surface3">#F4F6F6</Color>
    <Color x:Key="Sample.Color.Line">#170F1416</Color>
    <Color x:Key="Sample.Color.LineStrong">#260F1416</Color>
    <Color x:Key="Sample.Color.Ink">#0F1416</Color>
    <Color x:Key="Sample.Color.Ink2">#565F63</Color>
    <Color x:Key="Sample.Color.Ink3">#8C969B</Color>
    <Color x:Key="Sample.Color.Accent">#0E7C7B</Color>
    <Color x:Key="Sample.Color.AccentInk">#0A6362</Color>
    <Color x:Key="Sample.Color.AccentSoft">#1A0E7C7B</Color>
    <Color x:Key="Sample.Color.Warn">#A9690D</Color>
    <Color x:Key="Sample.Color.WarnSoft">#1FB4700F</Color>
    <Color x:Key="Sample.Color.Ok">#2E7D53</Color>
    <Color x:Key="Sample.Color.OkSoft">#1F2E7D53</Color>
    <Color x:Key="Sample.Color.Err">#B3372C</Color>
    <Color x:Key="Sample.Color.ErrSoft">#1AB3372C</Color>
    <Color x:Key="Sample.Color.Track">#120F1416</Color>

    <!-- XAML 查看器的语法着色 -->
    <Color x:Key="Sample.Color.Syntax.Tag">#0E7C7B</Color>
    <Color x:Key="Sample.Color.Syntax.Attr">#1F6FB2</Color>
    <Color x:Key="Sample.Color.Syntax.Value">#A9690D</Color>

    <SolidColorBrush x:Key="Sample.Page" Color="{StaticResource Sample.Color.Page}" />
    <SolidColorBrush x:Key="Sample.Surface" Color="{StaticResource Sample.Color.Surface}" />
    <SolidColorBrush x:Key="Sample.Surface2" Color="{StaticResource Sample.Color.Surface2}" />
    <SolidColorBrush x:Key="Sample.Surface3" Color="{StaticResource Sample.Color.Surface3}" />
    <SolidColorBrush x:Key="Sample.Line" Color="{StaticResource Sample.Color.Line}" />
    <SolidColorBrush x:Key="Sample.LineStrong" Color="{StaticResource Sample.Color.LineStrong}" />
    <SolidColorBrush x:Key="Sample.Ink" Color="{StaticResource Sample.Color.Ink}" />
    <SolidColorBrush x:Key="Sample.Ink2" Color="{StaticResource Sample.Color.Ink2}" />
    <SolidColorBrush x:Key="Sample.Ink3" Color="{StaticResource Sample.Color.Ink3}" />
    <SolidColorBrush x:Key="Sample.Accent" Color="{StaticResource Sample.Color.Accent}" />
    <SolidColorBrush x:Key="Sample.AccentInk" Color="{StaticResource Sample.Color.AccentInk}" />
    <SolidColorBrush x:Key="Sample.AccentSoft" Color="{StaticResource Sample.Color.AccentSoft}" />
    <SolidColorBrush x:Key="Sample.Warn" Color="{StaticResource Sample.Color.Warn}" />
    <SolidColorBrush x:Key="Sample.WarnSoft" Color="{StaticResource Sample.Color.WarnSoft}" />
    <SolidColorBrush x:Key="Sample.Ok" Color="{StaticResource Sample.Color.Ok}" />
    <SolidColorBrush x:Key="Sample.OkSoft" Color="{StaticResource Sample.Color.OkSoft}" />
    <SolidColorBrush x:Key="Sample.Err" Color="{StaticResource Sample.Color.Err}" />
    <SolidColorBrush x:Key="Sample.ErrSoft" Color="{StaticResource Sample.Color.ErrSoft}" />
    <SolidColorBrush x:Key="Sample.Track" Color="{StaticResource Sample.Color.Track}" />
    <SolidColorBrush x:Key="Sample.Syntax.Tag" Color="{StaticResource Sample.Color.Syntax.Tag}" />
    <SolidColorBrush x:Key="Sample.Syntax.Attr" Color="{StaticResource Sample.Color.Syntax.Attr}" />
    <SolidColorBrush x:Key="Sample.Syntax.Value" Color="{StaticResource Sample.Color.Syntax.Value}" />

    <!-- 侧栏选中态：浅色下是低饱和强调底 -->
    <SolidColorBrush x:Key="Sample.NavActiveBg" Color="{StaticResource Sample.Color.AccentSoft}" />
    <SolidColorBrush x:Key="Sample.NavHoverBg" Color="{StaticResource Sample.Color.Surface3}" />

    <!-- 字号阶梯（全局放大一档）：Micro 11 / Tiny 12 / Small 13 / Body 14 / CardTitle 15 / Title 21 / Hero 25 -->
    <sys:Double x:Key="Sample.Font.Micro">11</sys:Double>
    <sys:Double x:Key="Sample.Font.Tiny">12</sys:Double>
    <sys:Double x:Key="Sample.Font.Small">13</sys:Double>
    <sys:Double x:Key="Sample.Font.Body">14</sys:Double>
    <sys:Double x:Key="Sample.Font.CardTitle">15</sys:Double>
    <sys:Double x:Key="Sample.Font.Title">21</sys:Double>
    <sys:Double x:Key="Sample.Font.Hero">25</sys:Double>

    <FontFamily x:Key="Sample.FontFamily">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Sample.MonoFontFamily">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <CornerRadius x:Key="Sample.Radius.Card">9</CornerRadius>
    <CornerRadius x:Key="Sample.Radius.Control">6</CornerRadius>

</ResourceDictionary>
