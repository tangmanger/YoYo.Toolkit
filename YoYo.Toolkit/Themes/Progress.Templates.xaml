    <!-- ============ 参数化阵列组（ProgressPainter 自绘） ============ -->

    <!-- 05 · 信号带 -->
    <ControlTemplate x:Key="Progress.Template.Signal.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SignalPainter"
                                             Storyboard.TargetProperty="Phase"
                                             From="0" To="1" Duration="0:0:1.05"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="120" Height="60">
                    <p:ProgressPainter x:Name="SignalPainter" Canvas.Left="0" Canvas.Top="0"
                                       Width="120" Height="60"
                                       Pattern="Signal" Count="28"
                                       Accent="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                       Dim="{DynamicResource Progress.Brush.Track}" />
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 15 · 刻度游标环 -->
    <ControlTemplate x:Key="Progress.Template.TickRing.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="TickPainter"
                                             Storyboard.TargetProperty="Phase"
                                             From="0" To="1" Duration="0:0:1.6"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="120" Height="120">
                    <p:ProgressPainter x:Name="TickPainter" Canvas.Left="0" Canvas.Top="0"
                                       Width="120" Height="120"
                                       Pattern="Ticks" Count="24"
                                       Accent="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                       Dim="{DynamicResource Progress.Brush.InkDim}" />
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 16 · 行波线 -->
    <ControlTemplate x:Key="Progress.Template.Wave.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="WavePainter"
                                             Storyboard.TargetProperty="Phase"
                                             From="0" To="1"
                                             Duration="{DynamicResource Progress.Duration.Slow}"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="320" Height="60">
                    <p:ProgressPainter x:Name="WavePainter" Canvas.Left="0" Canvas.Top="0"
                                       Width="320" Height="60"
                                       Pattern="Wave" Thickness="2.4"
                                       Accent="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                       Dim="{DynamicResource Progress.Brush.Track}" />
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 17 · 点阵涟漪 -->
    <ControlTemplate x:Key="Progress.Template.DotMatrix.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MatrixPainter"
                                             Storyboard.TargetProperty="Phase"
                                             From="0" To="1" Duration="0:0:1.8"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 去掉 Viewbox 的 200→实际尺寸缩放：Painter 直接按 ActualWidth/Height 铺满，逐帧不再重采样 -->
            <p:ProgressPainter x:Name="MatrixPainter" Grid.Column="0"
                               Pattern="Matrix" Rows="9"
                               Accent="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                               Dim="{DynamicResource Progress.Brush.Track}" />

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 20 · 流星尾迹 -->
    <ControlTemplate x:Key="Progress.Template.Comet.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CometPainter"
                                             Storyboard.TargetProperty="Phase"
                                             From="0" To="1" Duration="0:0:1.6"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="120" Height="120">
                    <Ellipse Canvas.Left="14.4" Canvas.Top="14.4" Width="91.2" Height="91.2"
                             Stroke="{DynamicResource Progress.Brush.Guide}"
                             StrokeThickness="1"
                             StrokeDashArray="1 3" />
                    <p:ProgressPainter x:Name="CometPainter" Canvas.Left="0" Canvas.Top="0"
                                       Width="120" Height="120"
                                       Pattern="Comet" Count="6"
                                       Accent="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                       Dim="{DynamicResource Progress.Brush.Track}" />
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- ============ 确定态（收敛为 3 套，按 Kind 映射） ============ -->

    <!-- 条形确定态：FlowBar / CounterFlow / Skeleton 共用 -->
    <ControlTemplate x:Key="Progress.Template.FlowBar.Determinate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="320" Height="20">
                    <Rectangle Canvas.Left="0" Canvas.Top="8" Width="320" Height="4"
                               RadiusX="2" RadiusY="2"
                               Fill="{DynamicResource Progress.Brush.Track}" />
                    <Rectangle Canvas.Left="0" Canvas.Top="8" Width="320" Height="4"
                               RadiusX="2" RadiusY="2"
                               Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                               RenderTransformOrigin="0,0">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Percent, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.ValueText}"
                       Margin="12,0,0,0"
                       FontSize="13"
                       HorizontalAlignment="Right"
                       Text="{Binding Percent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Progress.PercentToText}}" />
        </Grid>
    </ControlTemplate>

    <!-- 环形确定态：Arc / DualRing / GlowRing 等共用 -->
    <ControlTemplate x:Key="Progress.Template.Arc.Determinate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="120" Height="120">
                    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="104" Height="104"
                             Stroke="{DynamicResource Progress.Brush.Guide}"
                             StrokeThickness="4" />
                    <Path Width="120" Height="120"
                          Stroke="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                          StrokeThickness="4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round">
                        <Path.Data>
                            <MultiBinding Converter="{StaticResource Progress.PercentToArc}"
                                          ConverterParameter="4">
                                <Binding Path="Percent" RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </Path.Data>
                    </Path>
                    <TextBlock Style="{StaticResource Progress.ValueText}"
                               Canvas.Left="0" Canvas.Top="50" Width="120"
                               Text="{Binding Percent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Progress.PercentToText}}" />
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 分段环形确定态：TickRing 专用 -->
    <ControlTemplate x:Key="Progress.Template.TickRing.Determinate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="120" Height="120">
                    <p:ProgressPainter Canvas.Left="0" Canvas.Top="0" Width="120" Height="120"
                                       Pattern="TicksProgress" Count="24"
                                       Phase="{Binding Percent, RelativeSource={RelativeSource TemplatedParent}}"
                                       Accent="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                       Dim="{DynamicResource Progress.Brush.Track}" />
                    <TextBlock Style="{StaticResource Progress.ValueText}"
                               Canvas.Left="0" Canvas.Top="50" Width="120" FontSize="15"
                               Text="{Binding Percent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Progress.PercentToText}}" />
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- ============ 流程步骤条 ============ -->

    <!--
        步骤项（横向）。每个步骤占一个等宽单元格（UniformGrid），节点在单元格内居中，
        连接线拆成「左半段 + 右半段」两条，在单元格边界处对接。
        这样整条链路随控件宽度自适应——旧版给每步固定 72px + 48px 连线，5 步要 552px，
        卡片只有 430px 时最后一步的标签会被裁掉。
    -->
    <DataTemplate x:Key="Progress.StepTracker.Item">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ConnectorLeft" Grid.Column="0" Height="1.6" VerticalAlignment="Center"
                        Background="{DynamicResource Progress.Brush.Track}" />

                <Grid Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Center">
                    <Ellipse x:Name="Halo" Width="28" Height="28" Opacity="0"
                             Stroke="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}"
                             StrokeThickness="1.6"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Border x:Name="Node" Width="26" Height="26" CornerRadius="13"
                            BorderThickness="1.6" Background="Transparent"
                            BorderBrush="{DynamicResource Progress.Brush.Guide}">
                        <TextBlock x:Name="Glyph" Text="{Binding Ordinal}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Progress.Brush.InkDim}" />
                    </Border>
                </Grid>

                <Border x:Name="ConnectorRight" Grid.Column="2" Height="1.6" VerticalAlignment="Center"
                        Background="{DynamicResource Progress.Brush.Track}" />
            </Grid>

            <!-- 标签不再限制宽度：单元格多宽就用多宽，只居中换行，不截断 -->
            <TextBlock x:Name="Caption" Grid.Row="1" Text="{Binding Label}" FontSize="11.5"
                       Margin="2,7,2,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource Progress.Brush.InkDim}" />
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Done">
                <Setter TargetName="Node" Property="Background" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" />
                <Setter TargetName="Node" Property="BorderBrush" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" />
                <Setter TargetName="Glyph" Property="Text" Value="✓" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Progress.Brush.OnAccent}" />
                <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource Progress.Brush.Ink}" />
                <Setter TargetName="ConnectorLeft" Property="Background" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" />
                <Setter TargetName="ConnectorRight" Property="Background" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding State}" Value="Active">
                <Setter TargetName="Node" Property="BorderBrush" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" />
                <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource Progress.Brush.Ink}" />
                <Setter TargetName="Caption" Property="FontWeight" Value="SemiBold" />
                <!-- 已走过的半段连接线跟着主色走，视觉上"进度条"停在当前步 -->
                <Setter TargetName="ConnectorLeft" Property="Background" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="HaloPulse">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                             From="1" To="1.7" Duration="0:0:1.4" />
                            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                             From="1" To="1.7" Duration="0:0:1.4" />
                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity"
                                             From="0.55" To="0" Duration="0:0:1.4" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="HaloPulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>

            <DataTrigger Binding="{Binding State}" Value="Error">
                <Setter TargetName="Node" Property="Background" Value="{DynamicResource Progress.Brush.Error}" />
                <Setter TargetName="Node" Property="BorderBrush" Value="{DynamicResource Progress.Brush.Error}" />
                <Setter TargetName="Glyph" Property="Text" Value="✗" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Progress.Brush.OnAccent}" />
                <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource Progress.Brush.Error}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding State}" Value="Skipped">
                <Setter TargetName="Node" Property="BorderBrush" Value="{DynamicResource Progress.Brush.InkDim}" />
                <Setter TargetName="Glyph" Property="Text" Value="–" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Progress.Brush.InkDim}" />
                <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource Progress.Brush.InkDim}" />
            </DataTrigger>

            <!-- 首尾各隐藏外侧半段：整条链路只在相邻节点之间出现 -->
            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                <Setter TargetName="ConnectorLeft" Property="Visibility" Value="Hidden" />
            </DataTrigger>

            <DataTrigger Binding="{Binding IsLast}" Value="True">
                <Setter TargetName="ConnectorRight" Property="Visibility" Value="Hidden" />
            </DataTrigger>

            <DataTrigger Binding="{Binding ShowConnector, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" Value="False">
                <Setter TargetName="ConnectorLeft" Property="Visibility" Value="Hidden" />
                <Setter TargetName="ConnectorRight" Property="Visibility" Value="Hidden" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 竖向排列用的步骤项：节点在上、标签在下，连接线画在节点上方（首步不画） -->
    <DataTemplate x:Key="Progress.StepTracker.Item.Vertical">
        <Grid Margin="0,0,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="ConnectorTop" Grid.Row="0" Width="1.6" Height="14" HorizontalAlignment="Center"
                    Background="{DynamicResource Progress.Brush.Track}" />

            <Grid Grid.Row="1" Width="28" Height="28" HorizontalAlignment="Center">
                <Ellipse x:Name="HaloV" Width="28" Height="28" Opacity="0"
                         Stroke="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}"
                         StrokeThickness="1.6"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="HaloScaleV" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Border x:Name="NodeV" Width="26" Height="26" CornerRadius="13"
                        BorderThickness="1.6" Background="Transparent"
                        BorderBrush="{DynamicResource Progress.Brush.Guide}">
                    <TextBlock x:Name="GlyphV" Text="{Binding Ordinal}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Progress.Brush.InkDim}" />
                </Border>
            </Grid>

            <TextBlock x:Name="CaptionV" Grid.Row="2" Text="{Binding Label}" FontSize="11.5"
                       Margin="2,7,2,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource Progress.Brush.InkDim}" />
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Done">
                <Setter TargetName="NodeV" Property="Background" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" />
                <Setter TargetName="NodeV" Property="BorderBrush" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" />
                <Setter TargetName="GlyphV" Property="Text" Value="✓" />
                <Setter TargetName="GlyphV" Property="Foreground" Value="{DynamicResource Progress.Brush.OnAccent}" />
                <Setter TargetName="CaptionV" Property="Foreground" Value="{DynamicResource Progress.Brush.Ink}" />
                <Setter TargetName="ConnectorTop" Property="Background" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding State}" Value="Active">
                <Setter TargetName="NodeV" Property="BorderBrush" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" />
                <Setter TargetName="GlyphV" Property="Foreground" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" />
                <Setter TargetName="CaptionV" Property="Foreground" Value="{DynamicResource Progress.Brush.Ink}" />
                <Setter TargetName="CaptionV" Property="FontWeight" Value="SemiBold" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="HaloPulseV">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="HaloScaleV" Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                             From="1" To="1.7" Duration="0:0:1.4" />
                            <DoubleAnimation Storyboard.TargetName="HaloScaleV" Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                             From="1" To="1.7" Duration="0:0:1.4" />
                            <DoubleAnimation Storyboard.TargetName="HaloV" Storyboard.TargetProperty="Opacity"
                                             From="0.55" To="0" Duration="0:0:1.4" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="HaloPulseV" />
                </DataTrigger.ExitActions>
            </DataTrigger>

            <DataTrigger Binding="{Binding State}" Value="Error">
                <Setter TargetName="NodeV" Property="Background" Value="{DynamicResource Progress.Brush.Error}" />
                <Setter TargetName="NodeV" Property="BorderBrush" Value="{DynamicResource Progress.Brush.Error}" />
                <Setter TargetName="GlyphV" Property="Text" Value="✗" />
                <Setter TargetName="GlyphV" Property="Foreground" Value="{DynamicResource Progress.Brush.OnAccent}" />
                <Setter TargetName="CaptionV" Property="Foreground" Value="{DynamicResource Progress.Brush.Error}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding State}" Value="Skipped">
                <Setter TargetName="NodeV" Property="BorderBrush" Value="{DynamicResource Progress.Brush.InkDim}" />
                <Setter TargetName="GlyphV" Property="Text" Value="–" />
                <Setter TargetName="GlyphV" Property="Foreground" Value="{DynamicResource Progress.Brush.InkDim}" />
                <Setter TargetName="CaptionV" Property="Foreground" Value="{DynamicResource Progress.Brush.InkDim}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                <Setter TargetName="ConnectorTop" Property="Visibility" Value="Hidden" />
            </DataTrigger>

            <DataTrigger Binding="{Binding ShowConnector, RelativeSource={RelativeSource AncestorType={x:Type p:StepTracker}}}" Value="False">
                <Setter TargetName="ConnectorTop" Property="Visibility" Value="Hidden" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ControlTemplate x:Key="Progress.Template.StepTracker" TargetType="{x:Type p:StepTracker}">
        <ItemsControl x:Name="Host" ItemsSource="{TemplateBinding Steps}" Background="Transparent"
                      ItemTemplate="{StaticResource Progress.StepTracker.Item}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- 等分宽度：步数再多也不会撑破容器 -->
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter TargetName="Host" Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="Host" Property="ItemTemplate"
                        Value="{StaticResource Progress.StepTracker.Item.Vertical}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>
