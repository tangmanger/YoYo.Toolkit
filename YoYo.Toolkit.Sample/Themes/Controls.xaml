<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:YoYo.ToolkitSample.Converters"
                    xmlns:yy="clr-namespace:YoYo.Toolkit.Controls.ComboBox;assembly=YoYo.Toolkit"
                    xmlns:bi="clr-namespace:YoYo.Toolkit.Controls.BusyIndicators;assembly=YoYo.Toolkit"
                    xmlns:ibtn="clr-namespace:YoYo.Toolkit.Controls.Button;assembly=YoYo.Toolkit"
                    xmlns:txt="clr-namespace:YoYo.Toolkit.Controls.Text;assembly=YoYo.Toolkit">

    <!--
        宿主侧模板。
        YoYo.Toolkit 只为 Progress 提供主题字典，其余控件（TreeComboBox / TProgressRing /
        IconRadioButton / PlaceholderTextBox / OutlineText 之外的部分）都要求宿主自己给 Style。
        这个文件就是「宿主示例」——真实项目里把同样的内容搬进你的主题字典即可。
    -->

    <conv:StringToGeometryConverter x:Key="StrToGeometry" />

    <!-- ================= 排版小件 ================= -->

    <Style x:Key="Sample.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Tiny}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink3}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Sample.KvKey" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink3}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Sample.KvValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.MonoFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Tiny}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 卡片内的小节标题（对应设计稿的 sec > h2 + 横线） -->
    <Style x:Key="Sample.SecTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.FontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
    </Style>

    <!-- 代码块 -->
    <Style x:Key="Sample.CodeBlock" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Sample.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sample.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style x:Key="Sample.CodeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.MonoFontFamily}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink2}" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 提示条 -->
    <Style x:Key="Sample.Note" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Sample.WarnSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sample.Warn}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="11,8" />
    </Style>

    <!-- 键值行底边 -->
    <Style x:Key="Sample.KvRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <!-- ================= 表格 ================= -->
    <Style x:Key="Sample.TableHead" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Sample.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sample.Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="11,5" />
    </Style>

    <Style x:Key="Sample.TableRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Sample.Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="11,6" />
    </Style>

    <Style x:Key="Sample.TableCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Tiny}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink2}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ================= PlaceholderTextBox ================= -->
    <Style x:Key="Sample.Placeholder" TargetType="{x:Type txt:PlaceholderTextBox}">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{DynamicResource Sample.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Sample.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Sample.AccentSoft}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,0" />
        <!--
            水印位置在宿主侧调 TransformY，不改库源码。
            库里 RefreshPlaceholder() 把水印画成 PART_DropButton 的 VisualBrush：
            VisualBrush 自动布局时 TextBlock 的 Margin(8,5,8,0) 基本不进内容边界，
            水印实际是从近 (0,0) 画起的，所以 TransformX/Y 是「补输入区内边距」而不是额外偏移：
              · TransformX 默认 16 —— 正好补上输入文字约 19px 的左内边距，保持默认即可；
              · TransformY 默认 15 —— 输入框内部高 30px、水印 14px 字形，居中只需下移约 7px，
                15 会把水印压到下沿被裁（就是「偏下」的现象）。
            这里只把 TransformY 调到 7，与输入文字同一基线。改输入框高度时按
            「(内部高 - 水印字形高) / 2」重算这个值即可。
        -->
        <Setter Property="TransformY" Value="7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type txt:PlaceholderTextBox}">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Sample.Surface}"
                            BorderBrush="{DynamicResource Sample.LineStrong}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <!-- 控件把水印画成这个 Border 的 VisualBrush，必须叫 PART_DropButton -->
                            <Border x:Name="PART_DropButton" Background="Transparent" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sample.Accent}" />
                        </Trigger>
                        <Trigger Property="IsShowError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sample.Err}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= TreeViewItem（树形下拉的节点外观） ================= -->
    <Style TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink2}" />
        <Setter Property="FontFamily" Value="{DynamicResource Sample.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Small}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="5,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Tw" Grid.Column="0" Width="9" Height="9" Stretch="Uniform"
                                      Data="M8,5 L13,10 L8,15" Stroke="{DynamicResource Sample.Ink3}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="TwRotate" Angle="90" />
                                    </Path.RenderTransform>
                                </Path>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" Margin="2,0,0,0" />
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Tw" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Tw" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sample.Surface3}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sample.AccentSoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Sample.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= TreeComboBox ================= -->
    <!--
        树形下拉：字段 + 箭头 + Popup，才是 ComboBox 的形态。
        IsDorpDown 双向驱动 Popup.IsOpen / ToggleButton.IsChecked；
        TreeComboBox.SetText() 选中末级后会把它置回 false，下拉自动收起。
    -->
    <Style x:Key="Sample.TreePanel" TargetType="{x:Type yy:TreeComboBox}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TreeViewItem">
                    <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Padding" Value="4,3" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type yy:TreeComboBox}">
                    <Grid>
                        <!-- ============ 字段 ============ -->
                        <ToggleButton x:Name="Field"
                                      Height="{TemplateBinding Height}"
                                      HorizontalContentAlignment="Stretch"
                                      Padding="9,0"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDorpDown, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="6"
                                            Background="{DynamicResource Sample.Surface2}"
                                            BorderBrush="{DynamicResource Sample.Line}"
                                            BorderThickness="1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{DynamicResource Sample.LineStrong}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{DynamicResource Sample.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Sample.Ink}" />
                                <Path Grid.Column="1" Data="M2,4 L7,9 L12,4"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource Sample.Ink3}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" Margin="8,0,2,0" />
                            </Grid>
                        </ToggleButton>

                        <!-- ============ 下拉面板 ============ -->
                        <Popup x:Name="TreePopup"
                               PlacementTarget="{Binding ElementName=Field}"
                               Placement="Bottom"
                               Width="{Binding ActualWidth, ElementName=Field}"
                               IsOpen="{Binding IsDorpDown, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <!-- 留白模拟投影，不用 DropShadowEffect（避免动画期重绘） -->
                            <Border Margin="0,3,7,7" CornerRadius="7" Padding="4"
                                    Background="{DynamicResource Sample.Surface}"
                                    BorderBrush="{DynamicResource Sample.LineStrong}"
                                    BorderThickness="1">
                                <ScrollViewer MaxHeight="188"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= IconRadioButton ================= -->
    <Style x:Key="Sample.IconOption" TargetType="{x:Type ibtn:IconRadioButton}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink2}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Small}" />
        <Setter Property="IconForeground" Value="{DynamicResource Sample.Ink3}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ibtn:IconRadioButton}">
                    <Border x:Name="Bd" CornerRadius="8" Padding="16,11" MinWidth="76"
                            Background="{DynamicResource Sample.Surface2}"
                            BorderBrush="{DynamicResource Sample.Line}" BorderThickness="1">
                        <StackPanel>
                            <Path x:Name="Ico" Width="21" Height="21" Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Data="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StrToGeometry}}"
                                  Stroke="{TemplateBinding IconForeground}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <ContentPresenter HorizontalAlignment="Center" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sample.LineStrong}" />
                            <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sample.AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sample.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Sample.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= TProgressRing ================= -->
    <Style x:Key="Sample.Ring" TargetType="{x:Type bi:TProgressRing}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type bi:TProgressRing}">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="28" Height="28">
                            <Ellipse Stroke="{DynamicResource Sample.Track}" StrokeThickness="2.6" />
                            <Path x:Name="Arc"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2.6"
                                  StrokeDashArray="1.6 3.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M14,1.4 A12.6,12.6 0 1 1 13.8,1.4"
                                  RenderTransformOrigin="0.5,0.5" Opacity="0.35">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="Spin" Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStory">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Spin"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinStory" />
                            </Trigger.ExitActions>
                            <Setter TargetName="Arc" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= PasswordBox ================= -->
    <Style x:Key="Sample.Password" TargetType="PasswordBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{DynamicResource Sample.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Sample.Accent}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{DynamicResource Sample.Surface}"
                            BorderBrush="{DynamicResource Sample.LineStrong}"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Border x:Name="PlaceHolderTextBorder" Background="Transparent" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sample.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Slider ================= -->
    <Style x:Key="Sample.Slider" TargetType="Slider">
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Sample.Track}"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{DynamicResource Sample.Accent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource Sample.Surface}"
                                                     Stroke="{DynamicResource Sample.Accent}" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        表格行按钮：模板里 ContentPresenter 必须跟随 HorizontalContentAlignment，
        否则 * 列会被按内容测量（列宽塌陷、文字叠在一起）——这是自绘表格最常见的坑。
    -->
    <Style x:Key="Sample.TableButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Sample.Line}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Sample.NavHoverBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
