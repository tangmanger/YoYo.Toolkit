    <!-- ================= 文本 ================= -->
    <Style x:Key="Sample.Kicker" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.MonoFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Micro}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink3}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Sample.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="Sample.Muted" TargetType="TextBlock" BasedOn="{StaticResource Sample.Body}">
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Tiny}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink3}" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Sample.CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.CardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Sample.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
    </Style>

    <Style x:Key="Sample.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.MonoFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Tiny}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink2}" />
    </Style>

    <!-- ================= 卡片 ================= -->
    <Style x:Key="Sample.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Sample.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sample.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Sample.Radius.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 键名小片 -->
    <Style x:Key="Sample.Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Sample.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sample.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Sample.ChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.MonoFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Micro}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink2}" />
    </Style>

    <!-- ================= 按钮 ================= -->
    <Style x:Key="Sample.Btn" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink2}" />
        <Setter Property="Background" Value="{DynamicResource Sample.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sample.LineStrong}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sample.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Sample.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sample.Surface3}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Sample.Btn.Primary" TargetType="Button" BasedOn="{StaticResource Sample.Btn}">
        <Setter Property="Background" Value="{DynamicResource Sample.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sample.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sample.AccentInk}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sample.AccentInk}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Sample.Btn.Small" TargetType="Button" BasedOn="{StaticResource Sample.Btn}">
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Tiny}" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style x:Key="Sample.Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Sample.Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink3}" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sample.Surface3}" />
                            <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        纯色块按钮：Sample.Btn.Ghost 的 Padding=7,0 会把 22px 宽按钮的内容区压到 8px，
        12px 的 Ellipse 被 ContentPresenter 裁成半圆。这里把内边距归零并给足尺寸，
        色块才能显示成整圆（按钮本身仍是透明无边框的 Ghost）。
    -->
    <Style x:Key="Sample.Btn.Ghost.Swatch" TargetType="Button" BasedOn="{StaticResource Sample.Btn.Ghost}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 标题栏窗口按钮 -->
    <Style x:Key="Sample.WinBtn" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sample.Surface3}" />
                            <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Sample.WinBtn.Close" TargetType="Button" BasedOn="{StaticResource Sample.WinBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 侧栏项 ================= -->
    <Style x:Key="Sample.NavItem" TargetType="Button">
        <Setter Property="Height" Value="31" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink2}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="-2,11,0,11"
                                    CornerRadius="1" Background="{DynamicResource Sample.Accent}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="8,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sample.NavHoverBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sample.NavActiveBg}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Sample.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 分段按钮 ================= -->
    <Style x:Key="Sample.Segment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Sample.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink2}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sample.AccentSoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Sample.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 输入框 ================= -->
    <Style x:Key="Sample.Input" TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{DynamicResource Sample.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Sample.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Sample.AccentSoft}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{DynamicResource Sample.Surface}"
                            BorderBrush="{DynamicResource Sample.LineStrong}"
                            BorderThickness="1" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sample.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 列表（控件用法目录用） ================= -->
    <Style x:Key="Sample.ListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink2}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Margin="-7,5,0,5" Background="{DynamicResource Sample.Accent}"
                                    Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sample.Surface3}" />
                            <Setter Property="Foreground" Value="{DynamicResource Sample.Ink}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sample.AccentSoft}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Sample.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Sample.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Sample.ListItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- ================= 细滚动条 ================= -->
    <Style x:Key="Sample.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Sample.LineStrong}" CornerRadius="2" Margin="2,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Sample.ScrollThumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                        </Track.IncreaseRepeatButton>
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                        </Track.DecreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Sample.ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= 切换开关 ================= -->
    <Style x:Key="Sample.Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Sample.Ink2}" />
        <Setter Property="FontSize" Value="{DynamicResource Sample.Font.Small}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="28" Height="16" CornerRadius="9"
                                Background="{DynamicResource Sample.Track}" VerticalAlignment="Center">
                            <!--
                                阴影只允许挂在这种"纯装饰、没有子元素"的 Border 上。
                                Effect 会先把元素连同子树渲染到中间位图再加模糊：挂在承载文字的控件上
                                文字会发虚，挂在布局容器上更会让整帧重复栅格化。
                            -->
                            <Border x:Name="Knob" Width="12" Height="12" CornerRadius="6"
                                    Background="{DynamicResource Sample.Surface}"
                                    HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.25" Color="Black" />
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Sample.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
