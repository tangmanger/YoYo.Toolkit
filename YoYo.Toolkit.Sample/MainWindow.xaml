<Window x:Class="YoYo.ToolkitSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:YoYo.ToolkitSample.Converters"
        mc:Ignorable="d"
        Title="YoYo.Toolkit · 示例程序"
        Width="1440" Height="900" MinWidth="1080" MinHeight="660"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Sample.Page}"
        FontFamily="{DynamicResource Sample.FontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        DataContext="{Binding Main, Source={StaticResource locator}}">

    <!--
        自定义标题栏用 WindowChrome 承载：外框、拖拽区域、缩放边由系统管，
        圆角与阴影交给 DWM（见 Services/WindowFrame.cs）。
        不要再开 AllowsTransparency 自己画阴影——那会关掉硬件合成，文字发虚、拖动掉帧。
    -->
    <shell:WindowChrome.WindowChrome>
        <!-- 与 PackageEasy 一致：玻璃边框静态写 0,0,0,1，最大化尺寸交给系统按工作区算，
             不需要在 StateChanged 里运行时改 GlassFrameThickness / ResizeBorderThickness。 -->
        <shell:WindowChrome CaptionHeight="40"
                            GlassFrameThickness="0,0,0,1"
                            NonClientFrameEdges="None"
                            ResizeBorderThickness="4"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding ToggleThemeCommand}" />
        <KeyBinding Key="F12" Command="{Binding ShowUsageCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:ResourceKeyToGeometryConverter x:Key="IconKey" />
    </Window.Resources>

    <!-- 圆角由 DWM 裁，这里只画 1px 内描边；最大化时两者都归零，否则四角会露出缝隙 -->
    <Border Background="{DynamicResource Sample.Page}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Sample.LineStrong}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ================= 标题栏 ================= -->
            <Grid Grid.Row="0" Background="{DynamicResource Sample.Surface}">
                <Border BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,0,0,1" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="21" Height="21" CornerRadius="5" Background="{DynamicResource Sample.Accent}">
                        <TextBlock Text="YY" FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="YoYo.Toolkit" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Sample.Ink}" Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                    <Border Width="1" Height="13" Background="{DynamicResource Sample.LineStrong}" Margin="9,0" />
                    <TextBlock Text="示例程序" FontSize="13.5" Foreground="{DynamicResource Sample.Ink2}"
                               VerticalAlignment="Center" />
                    <Border Style="{StaticResource Sample.Chip}" Margin="8,0,0,0">
                        <TextBlock Text="v1.0.0" Style="{StaticResource Sample.ChipText}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Border Width="212" Height="26" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,12,0"
                            Background="{DynamicResource Sample.Surface2}"
                            BorderBrush="{DynamicResource Sample.Line}" BorderThickness="1"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Width="12" Height="12"
                                  Stretch="Uniform" Stroke="{DynamicResource Sample.Ink3}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="8,0,0,0"
                                  VerticalAlignment="Center" />
                            <TextBox x:Name="GlobalSearch" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="13"
                                     Foreground="{DynamicResource Sample.Ink}" VerticalContentAlignment="Center"
                                     Padding="6,0,0,0" CaretBrush="{DynamicResource Sample.Accent}"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                            <Border Grid.Column="2" Margin="0,0,7,0" Padding="4,1" CornerRadius="4"
                                    BorderBrush="{DynamicResource Sample.Line}" BorderThickness="1"
                                    Background="{DynamicResource Sample.Surface}" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl K" FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                           FontSize="10.5" Foreground="{DynamicResource Sample.Ink3}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 深/浅色切换：浅色时显示月亮（点了进深色），深色时显示太阳 -->
                    <Button Style="{StaticResource Sample.WinBtn}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="切换深色 / 浅色（Ctrl+T）"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource Icon.Moon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource Icon.Sun}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <!-- 与 PackageEasy 一致：窗口动作走 SystemCommands 路由命令 + Window.CommandBindings -->
                    <Button Style="{StaticResource Sample.WinBtn}"
                            Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource Icon.Min}" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" />
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource Sample.WinBtn}"
                            Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource Icon.Max}" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" />
                    </Button>
                    <Button x:Name="RestoreButton" Style="{StaticResource Sample.WinBtn}"
                            Command="{x:Static SystemCommands.RestoreWindowCommand}"
                            Visibility="Collapsed"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource Icon.Restore}" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" />
                    </Button>
                    <Button Style="{StaticResource Sample.WinBtn.Close}"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource Icon.Close}" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= 主体 ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧栏 -->
                <Border Grid.Column="0" Background="{DynamicResource Sample.Surface}"
                        BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,0,1,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="238" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRail}" Value="True">
                                    <Setter Property="Width" Value="62" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="10,10,10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="27" CornerRadius="6"
                                    Background="{DynamicResource Sample.Surface2}"
                                    BorderBrush="{DynamicResource Sample.Line}" BorderThickness="1"
                                    Visibility="{Binding IsRail, Converter={StaticResource InverseBoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Width="11" Height="11"
                                          Stretch="Uniform" Stroke="{DynamicResource Sample.Ink3}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="7,0,0,0"
                                          VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                             FontSize="13" Foreground="{DynamicResource Sample.Ink}"
                                             VerticalContentAlignment="Center" Padding="5,0,0,0"
                                             CaretBrush="{DynamicResource Sample.Accent}"
                                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource Sample.Btn.Ghost}" Width="27" Height="27"
                                    Margin="6,0,0,0" Command="{Binding ToggleRailCommand}" ToolTip="{Binding RailLabel}">
                                <Path Data="{StaticResource Icon.Panel}" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="8,2,8,10">
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Sample.Kicker}"
                                                       Margin="8,9,8,6"
                                                       Visibility="{Binding DataContext.IsRail, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Sample.NavItem}"
                                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding ViewType}"
                                                                ToolTip="{Binding Label}"
                                                                Margin="0,1"
                                                                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{Binding IconKey, Converter={StaticResource IconKey}}"
                                                                      Width="16" Height="16" Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.6" StrokeLineJoin="Round"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Label}" FontSize="14"
                                                                           Margin="9,0,0,0" VerticalAlignment="Center"
                                                                           Visibility="{Binding DataContext.IsRail, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}" />
                                                                <TextBlock Text="{Binding ViewType}"
                                                                           FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                                                           FontSize="11" Margin="10,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Sample.Ink3}"
                                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="12,9,12,10"
                                    Visibility="{Binding IsRail, Converter={StaticResource InverseBoolToVis}}">
                            <Border BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,1,0,0" Margin="0,0,0,7" />
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="MainNavigation" FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                           FontSize="11.5" Foreground="{DynamicResource Sample.Ink3}" />
                                <TextBlock Text="{Binding NavigateCount}" HorizontalAlignment="Right"
                                           FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Sample.Ink2}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="IGetService" FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                           FontSize="11.5" Foreground="{DynamicResource Sample.Ink3}" />
                                <TextBlock Text="Shell" HorizontalAlignment="Right"
                                           FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Sample.Ink2}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 主区 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,13,24,13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MainNavigation" Style="{StaticResource Sample.Kicker}" />
                                <TextBlock Text="  /  " Style="{StaticResource Sample.Kicker}" Opacity="0.6" />
                                <TextBlock Text="{Binding PageKey}" Style="{StaticResource Sample.Kicker}"
                                           Foreground="{DynamicResource Sample.Ink2}" />
                            </StackPanel>
                            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Sample.Title}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding PageLede}" Style="{StaticResource Sample.Muted}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- 控件用法目录：看每个控件怎么用，不是整页源码 -->
                        <Button Style="{StaticResource Sample.Btn.Small}" Command="{Binding ShowUsageCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                ToolTip="看这个控件怎么用（F12）">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Code}" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="控件用法" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,0,24,26">
                        <ContentControl Content="{Binding Content}" />
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ================= 状态栏 ================= -->
            <Border Grid.Row="2" Background="{DynamicResource Sample.Surface}"
                    BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource Sample.Ok}" VerticalAlignment="Center" />
                        <TextBlock Text="MainNavigation" Margin="6,0,0,0" FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                   FontSize="11.5" Foreground="{DynamicResource Sample.Ink3}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding NavigateCount}" FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                   FontSize="11.5" Foreground="{DynamicResource Sample.Ink3}" />
                        <TextBlock Text="NavigateModel" Margin="4,0,0,0" FontFamily="{DynamicResource Sample.MonoFontFamily}"
                                   FontSize="11.5" Foreground="{DynamicResource Sample.Ink3}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding LastLogTime}" Foreground="{DynamicResource Sample.Accent}"
                                   FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="11.5" />
                        <TextBlock Text="{Binding LastLog}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Sample.Ink3}"
                                   FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="11.5" />
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="{Binding ThemeLabel}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource Sample.Ink3}"
                               FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="11.5" />
                    <TextBlock Grid.Column="4" Text="net8.0-windows" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource Sample.Ink3}"
                               FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="11.5" />
                    <TextBlock Grid.Column="5" Text="AnyCPU" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource Sample.Ink3}"
                               FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="11.5" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
