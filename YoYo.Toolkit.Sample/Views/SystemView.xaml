<UserControl x:Class="YoYo.ToolkitSample.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Sample.FontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True">

    <StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ SystemHelper ============ -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Sample.Card}" Padding="14,12"
                    Margin="0,0,10,10">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="SystemHelper" Style="{StaticResource Sample.CardTitle}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding InitState}" Style="{StaticResource Sample.Kicker}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Sample.Btn.Small}" Content="重新 Init()"
                                    Height="22" Command="{Binding RefreshCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ComputerName" Style="{StaticResource Sample.KvKey}" />
                        <TextBlock Grid.Column="1" Text="{Binding ComputerName}" Style="{StaticResource Sample.KvValue}" />
                    </Grid>
                    <Border BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,1,0,0" />

                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="HardDiskID" Style="{StaticResource Sample.KvKey}" />
                        <TextBlock Grid.Column="1" Text="{Binding HardDiskId}" Style="{StaticResource Sample.KvValue}" />
                    </Grid>
                    <Border BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,1,0,0" />

                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ServerId" Style="{StaticResource Sample.KvKey}" />
                        <TextBlock Grid.Column="1" Text="{Binding ServerId}" Style="{StaticResource Sample.KvValue}" />
                    </Grid>
                    <Border BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,1,0,0" />

                    <Grid Margin="0,5,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="授权指纹 · MD5" Style="{StaticResource Sample.KvKey}" />
                        <TextBlock Grid.Column="1" Text="{Binding Fingerprint}" Style="{StaticResource Sample.KvValue}"
                                   Foreground="{DynamicResource Sample.Accent}" FontWeight="SemiBold" />
                    </Grid>

                    <Border BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,1,0,0" Margin="0,8,0,6" />
                    <TextBlock Style="{StaticResource Sample.Kicker}" TextWrapping="Wrap"
                               Text="SystemHelper.Init() 读 WMI：硬盘序列号 + 主板 ID + 机器名，授权绑定的常用三件套" />
                </StackPanel>
            </Border>

            <!-- ============ DateTimeHelper ============ -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Sample.Card}" Padding="14,12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="DateTimeHelper" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="Time" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GetUnixTime()" Style="{StaticResource Sample.KvKey}" />
                        <TextBlock Grid.Column="1" Text="{Binding UnixSeconds}" Style="{StaticResource Sample.KvValue}"
                                   Foreground="{DynamicResource Sample.Accent}" FontWeight="SemiBold" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="当前本地时间" Style="{StaticResource Sample.KvKey}" />
                        <TextBlock Grid.Column="1" Text="{Binding NowLocal}" Style="{StaticResource Sample.KvValue}" />
                    </Grid>

                    <Border Background="{DynamicResource Sample.WarnSoft}" CornerRadius="5" Padding="9,6"
                            Margin="0,0,0,9" MinHeight="38">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Sample.Kicker}"
                                       Foreground="{DynamicResource Sample.Ink2}"
                                       Text="单位不一致：GetUnixTime() 返回秒" />
                            <TextBlock Style="{StaticResource Sample.Kicker}"
                                       Foreground="{DynamicResource Sample.Ink2}" Margin="0,3,0,0"
                                       Text="UnixTimestampToDateTimeNoTimeZone(long) 按毫秒" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="UnixTimestampToDateTimeNoTimeZone(long 毫秒)"
                               Style="{StaticResource Sample.FieldLabel}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource Sample.Input}" Width="150" Height="26"
                                 FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="12.5"
                                 Text="{Binding TimestampInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource Sample.Btn.Small}" Content="转换" Height="26"
                                Margin="6,0,0,0" Padding="10,0"
                                Command="{Binding ConvertTimestampCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding TimestampOutput}" Style="{StaticResource Sample.Kicker}"
                               Margin="0,4,0,0" />

                    <TextBlock Text="DateTimeToUnixTimestampNoTimeZone(DateTime)"
                               Style="{StaticResource Sample.FieldLabel}" Margin="0,9,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource Sample.Input}" Width="150" Height="26"
                                 FontFamily="{DynamicResource Sample.MonoFontFamily}" FontSize="12.5"
                                 Text="{Binding DateTimeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource Sample.Btn.Small}" Content="转换" Height="26"
                                Margin="6,0,0,0" Padding="10,0"
                                Command="{Binding ConvertDateTimeCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DateTimeOutput}" Style="{StaticResource Sample.Kicker}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ ImageHelper（真调用 + 覆盖验证） ============ -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Sample.Card}" Padding="14,12"
                    Margin="0,0,10,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="ImageHelper" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="Images" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="72" Height="72" CornerRadius="7" ClipToBounds="True"
                                Background="{DynamicResource Sample.Surface2}"
                                BorderBrush="{DynamicResource Sample.Line}" BorderThickness="1">
                            <Grid>
                                <Path Data="M3,4.5 L21,4.5 L21,19.5 L3,19.5 Z M3.6,16.4 L9.2,11 L13.6,15.2 L16.6,12.6 L20.4,17"
                                      Stretch="Uniform" Margin="14" Stroke="{DynamicResource Sample.Ink3}"
                                      StrokeThickness="1.3">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LoadedImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Image Source="{Binding LoadedImage}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="12,0,0,0" Width="220" VerticalAlignment="Center">
                            <TextBlock Text="path.GetBitmapImage()" Style="{StaticResource Sample.Kicker}"
                                       Foreground="{DynamicResource Sample.Ink2}" />
                            <TextBlock Text="{Binding ImageInfo}" Style="{StaticResource Sample.Muted}"
                                       Margin="0,3,0,0" />
                            <TextBlock Text="{Binding ImageStatus}" Style="{StaticResource Sample.Kicker}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource Sample.Btn.Small}" Content="选择图片" Height="24"
                                Padding="9,0" Command="{Binding PickImageCommand}" />
                        <Button Style="{StaticResource Sample.Btn.Small}" Content="覆盖同一路径" Height="24"
                                Padding="9,0" Margin="6,0,0,0" IsEnabled="{Binding CanOverwrite}"
                                Command="{Binding OverwriteImageCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Sample.Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="扩展方法先读进 MemoryStream + CacheOption.OnLoad，EndInit 后不持有文件句柄，所以同一路径能被反复覆盖。" />
                </StackPanel>
            </Border>

            <!-- ============ AnimationHelper · Kernel32 ============ -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Sample.Card}" Padding="14,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="AnimationHelper · Kernel32" Style="{StaticResource Sample.CardTitle}" />
                        <TextBlock Text="Animations · WinApis" HorizontalAlignment="Right"
                                   Style="{StaticResource Sample.Kicker}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Sample.Muted}"
                               Text="AnimationHelper 提供附加属性式的动画辅助；Kernel32.CopyMemory 用于与设备 SDK 的非托管缓冲区对接。" />
                    <WrapPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource Sample.Chip}" Margin="0,0,5,0">
                            <TextBlock Text="CopyMemory" Style="{StaticResource Sample.ChipText}" />
                        </Border>
                        <Border Style="{StaticResource Sample.Chip}" Margin="0,0,5,0">
                            <TextBlock Text="SetAnim" Style="{StaticResource Sample.ChipText}" />
                        </Border>
                        <Border Style="{StaticResource Sample.Chip}">
                            <TextBlock Text="Pointer → byte[]" Style="{StaticResource Sample.ChipText}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 工具模块清单 ============ -->
        <TextBlock Text="工具模块清单" Style="{StaticResource Sample.SecTitle}" Margin="0,20,0,0" />
        <Border BorderBrush="{DynamicResource Sample.Line}" BorderThickness="0,0,0,1" Margin="0,7,0,11"
                Height="1" />
        <TextBlock Text="按命名空间取用，互不牵连" Style="{StaticResource Sample.Kicker}"
                   Margin="0,-9,0,10" />

        <Border Style="{StaticResource Sample.Card}" Padding="0">
            <StackPanel>
                <Border Style="{StaticResource Sample.TableHead}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="命名空间" Style="{StaticResource Sample.Kicker}" />
                        <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource Sample.Kicker}" />
                        <TextBlock Grid.Column="2" Text="用途" Style="{StaticResource Sample.Kicker}" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Sample.TableRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Namespace}"
                                               Style="{StaticResource Sample.TableCell}"
                                               FontFamily="{DynamicResource Sample.MonoFontFamily}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Type}"
                                               Style="{StaticResource Sample.TableCell}"
                                               Foreground="{DynamicResource Sample.Ink}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Usage}"
                                               Style="{StaticResource Sample.TableCell}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
