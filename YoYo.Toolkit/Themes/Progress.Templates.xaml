<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:YoYo.Toolkit.Controls.Progress"
                    xmlns:conv="clr-namespace:YoYo.Toolkit.Converters">

    <!--
        模板字典。全部模板只引用 Progress.* 令牌，不含字面颜色与字面时长。
        宿主覆盖：在 App.xaml 中定义同名 x:Key 即可，先于本字典被查找。

        约定：模板根为 Grid(PART_Root)，第一列是 Viewbox(固定画布)，第二列是状态文案。
        视觉状态组必须是 ProgressStates，含 Idle / Running / RunningReduced / Success / Error / Paused。
    -->

    <!-- 状态文案的通用排版。所有模板共用，避免逐套重复一套触发器。 -->
    <Style x:Key="Progress.StatusText" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource Progress.Brush.InkSecondary}" />
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowStatusText, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 环形确定态需要的弧线几何转换，唯一新增的几何转换器 -->
    <conv:PercentToArcGeometryConverter x:Key="Progress.PercentToArc" />

    <!-- 0~1 → "68%"，确定态数值文案统一走这里 -->
    <conv:PercentToTextConverter x:Key="Progress.PercentToText" />

    <!-- 确定态数值排版：等宽字体，读数不跳动 -->
    <Style x:Key="Progress.ValueText" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Progress.Font.Caption}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource Progress.Brush.InkSecondary}" />
    </Style>

    <!-- ============ 兜底 ============ -->

    <ControlTemplate x:Key="Progress.Template.Default" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="120" Height="120">
                    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="104" Height="104"
                             Stroke="{DynamicResource Progress.Brush.Guide}"
                             StrokeThickness="4" />
                    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="104" Height="104"
                             Stroke="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                             StrokeThickness="4"
                             StrokeDashArray="22.5 59.18"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>
            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- ============ 环形组 ============ -->

    <!-- 08 · 旋转弧环 -->
    <ControlTemplate x:Key="Progress.Template.Arc.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ArcRotate"
                                             Storyboard.TargetProperty="(RotateTransform.Angle)"
                                             From="0" To="360"
                                             Duration="{DynamicResource Progress.Duration.Fast}"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ProgressArc"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SuccessGlyph"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Error">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ProgressArc"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ErrorGlyph"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="120" Height="120">
                    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="104" Height="104"
                             Stroke="{DynamicResource Progress.Brush.Guide}"
                             StrokeThickness="4" />
                    <Ellipse x:Name="ProgressArc"
                             Canvas.Left="8" Canvas.Top="8" Width="104" Height="104"
                             Stroke="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                             StrokeThickness="4"
                             StrokeDashArray="22.5 59.18"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="ArcRotate" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Path x:Name="SuccessGlyph"
                          Data="M 50,62 L 57,69 L 71,53"
                          Stroke="{DynamicResource Progress.Brush.Success}"
                          StrokeThickness="4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Visibility="Collapsed" />
                    <Path x:Name="ErrorGlyph"
                          Data="M 53,53 L 67,67 M 67,53 L 53,67"
                          Stroke="{DynamicResource Progress.Brush.Error}"
                          StrokeThickness="4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Visibility="Collapsed" />
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 12 · 行进虚线环 -->
    <ControlTemplate x:Key="Progress.Template.MarchingRing.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MarchRotate"
                                             Storyboard.TargetProperty="(RotateTransform.Angle)"
                                             From="0" To="360"
                                             Duration="{DynamicResource Progress.Duration.Fast}"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="120" Height="120">
                    <Ellipse Canvas.Left="7.5" Canvas.Top="7.5" Width="105" Height="105"
                             Stroke="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                             StrokeThickness="3"
                             StrokeDashArray="4.67 3.33"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="MarchRotate" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Canvas.Left="56.5" Canvas.Top="56.5" Width="7" Height="7"
                             Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                             Opacity="0.7" />
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 19 · 对流双环 -->
    <ControlTemplate x:Key="Progress.Template.DualRing.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="DualOuter"
                                             Storyboard.TargetProperty="(RotateTransform.Angle)"
                                             From="0" To="360"
                                             Duration="{DynamicResource Progress.Duration.Base}"
                                             RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="DualInner"
                                             Storyboard.TargetProperty="(RotateTransform.Angle)"
                                             From="360" To="0"
                                             Duration="{DynamicResource Progress.Duration.Medium}"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="120" Height="120">
                    <!-- 外圈：10:30 → 4:30 的半弧（左上经右到右下），顺时针 1.4s -->
                    <Path Data="M 98.89,21.11 A 55,55 0 0 1 21.11,98.89"
                          Stroke="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round">
                        <Path.RenderTransform>
                            <!-- 半弧包围盒只有一半，RenderTransformOrigin 会把轴放到矩形中心，必须显式给环心 -->
                            <RotateTransform x:Name="DualOuter" CenterX="60" CenterY="60" />
                        </Path.RenderTransform>
                    </Path>
                    <!-- 内圈：4:30 → 10:30 的半弧，与外圈留 13px 间隙，逆时针 1.9s -->
                    <Path Data="M 30.30,90.30 A 42,42 0 0 1 89.70,30.30"
                          Stroke="{DynamicResource Progress.Brush.Secondary}"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="DualInner" CenterX="60" CenterY="60" />
                        </Path.RenderTransform>
                    </Path>
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 24 · 流光环 -->
    <ControlTemplate x:Key="Progress.Template.GlowRing.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="GlowRotate"
                                             Storyboard.TargetProperty="(RotateTransform.Angle)"
                                             From="0" To="360"
                                             Duration="{DynamicResource Progress.Duration.Base}"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="120" Height="120">
                    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="104" Height="104"
                             Stroke="{DynamicResource Progress.Brush.Guide}"
                             StrokeThickness="3" />
                    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="104" Height="104"
                             Stroke="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                             StrokeThickness="3"
                             StrokeDashArray="105 3.9"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="#40FFFFFF" Offset="0.42" />
                                <GradientStop Color="Black" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.OpacityMask>
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="GlowRotate" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- ============ 条形组 ============ -->

    <!-- 07 · 流动扫光条 -->
    <ControlTemplate x:Key="Progress.Template.FlowBar.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="FlowShift"
                                             Storyboard.TargetProperty="(TranslateTransform.X)"
                                             From="-128" To="320"
                                             Duration="{DynamicResource Progress.Duration.Base}"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Border Width="320" Height="20" ClipToBounds="True">
                    <Canvas Width="320" Height="20">
                        <Rectangle Canvas.Left="0" Canvas.Top="8" Width="320" Height="4"
                                   RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource Progress.Brush.Track}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="8" Width="128" Height="4"
                                   RadiusX="2" RadiusY="2"
                                   Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Black" Offset="0.5" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="FlowShift" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                </Border>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 13 · 对向游走 -->
    <ControlTemplate x:Key="Progress.Template.CounterFlow.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ForwardShift"
                                             Storyboard.TargetProperty="(TranslateTransform.X)"
                                             From="-102" To="320"
                                             Duration="{DynamicResource Progress.Duration.Base}"
                                             RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="BackwardShift"
                                             Storyboard.TargetProperty="(TranslateTransform.X)"
                                             From="320" To="-102"
                                             Duration="{DynamicResource Progress.Duration.Base}"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Border Width="320" Height="20" ClipToBounds="True">
                    <Canvas Width="320" Height="20">
                        <Rectangle Canvas.Left="0" Canvas.Top="8" Width="320" Height="4"
                                   RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource Progress.Brush.Track}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="8" Width="102" Height="4"
                                   RadiusX="2" RadiusY="2"
                                   Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="ForwardShift" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Canvas.Left="0" Canvas.Top="8" Width="102" Height="4"
                                   RadiusX="2" RadiusY="2" Opacity="0.55"
                                   Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="BackwardShift" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                </Border>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 22 · 屏幕扫描 -->
    <ControlTemplate x:Key="Progress.Template.Scan.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ScanShift"
                                             Storyboard.TargetProperty="(TranslateTransform.Y)"
                                             From="2" To="80"
                                             Duration="{DynamicResource Progress.Duration.Slow}"
                                             AutoReverse="True"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Grid Width="150" Height="96">
                    <Border CornerRadius="10"
                            Background="{DynamicResource Progress.Brush.Track}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Progress.Brush.Guide}"
                            ClipToBounds="True">
                        <Canvas Width="148" Height="94">
                            <!-- 被扫描的内容示意，让扫描线有可读对象 -->
                            <Rectangle Canvas.Left="16" Canvas.Top="20" Width="72" Height="6" RadiusX="3" RadiusY="3"
                                       Fill="{DynamicResource Progress.Brush.Guide}" />
                            <Rectangle Canvas.Left="16" Canvas.Top="34" Width="112" Height="4" RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource Progress.Brush.Guide}" />
                            <Rectangle Canvas.Left="16" Canvas.Top="46" Width="96" Height="4" RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource Progress.Brush.Guide}" />
                            <Rectangle Canvas.Left="16" Canvas.Top="58" Width="104" Height="4" RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource Progress.Brush.Guide}" />
                            <Rectangle Canvas.Left="16" Canvas.Top="70" Width="60" Height="4" RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource Progress.Brush.Guide}" />

                            <Canvas Width="148" Height="94">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="ScanShift" Y="12" />
                                </Canvas.RenderTransform>
                                <!-- 光带 + 扫描线：光带给厚度，扫描线给边界 -->
                                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="148" Height="12"
                                           Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                           Opacity="0.14" />
                                <Rectangle Canvas.Left="0" Canvas.Top="5" Width="148" Height="1.6"
                                           Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Canvas>
                        </Canvas>
                    </Border>
                </Grid>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 11 · 骨架扫光 -->
    <ControlTemplate x:Key="Progress.Template.Skeleton.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ShimmerShift"
                                             Storyboard.TargetProperty="(TranslateTransform.X)"
                                             From="-120" To="320"
                                             Duration="{DynamicResource Progress.Duration.Base}"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Border Width="320" Height="60" ClipToBounds="True">
                    <Canvas Width="320" Height="60">
                        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="320" Height="12"
                                   RadiusX="4" RadiusY="4"
                                   Fill="{DynamicResource Progress.Brush.Track}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="22" Width="192" Height="12"
                                   RadiusX="4" RadiusY="4"
                                   Fill="{DynamicResource Progress.Brush.Track}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="44" Width="320" Height="12"
                                   RadiusX="4" RadiusY="4"
                                   Fill="{DynamicResource Progress.Brush.Track}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="120" Height="60"
                                   Fill="#FFFFFF" Opacity="0.3">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Black" Offset="0.5" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="ShimmerShift" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                </Border>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- ============ 点组 ============ -->

    <!-- 09 · 三点脉动 -->
    <ControlTemplate x:Key="Progress.Template.BounceDots.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotA"
                                                           Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                                           Duration="{DynamicResource Progress.Duration.Fast}"
                                                           RepeatBehavior="Forever">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="0.4" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotA"
                                                           Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                                           Duration="{DynamicResource Progress.Duration.Fast}"
                                                           RepeatBehavior="Forever">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="0.4" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotB"
                                                           Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                                           BeginTime="0:0:0.16"
                                                           Duration="{DynamicResource Progress.Duration.Fast}"
                                                           RepeatBehavior="Forever">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="0.4" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotB"
                                                           Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                                           BeginTime="0:0:0.16"
                                                           Duration="{DynamicResource Progress.Duration.Fast}"
                                                           RepeatBehavior="Forever">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="0.4" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotC"
                                                           Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                                           BeginTime="0:0:0.32"
                                                           Duration="{DynamicResource Progress.Duration.Fast}"
                                                           RepeatBehavior="Forever">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="0.4" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotC"
                                                           Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                                           BeginTime="0:0:0.32"
                                                           Duration="{DynamicResource Progress.Duration.Fast}"
                                                           RepeatBehavior="Forever">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="0.4" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="120" Height="24">
                    <Ellipse Canvas.Left="38" Canvas.Top="7.5" Width="9" Height="9"
                             Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="DotA" ScaleX="0.4" ScaleY="0.4" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Canvas.Left="56" Canvas.Top="7.5" Width="9" Height="9"
                             Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="DotB" ScaleX="0.4" ScaleY="0.4" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Canvas.Left="74" Canvas.Top="7.5" Width="9" Height="9"
                             Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="DotC" ScaleX="0.4" ScaleY="0.4" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 10 · 声纳波纹：单 Phase 自绘，替代 6 条 Scale/Opacity 动画 -->
    <ControlTemplate x:Key="Progress.Template.Sonar.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SonarPainter"
                                             Storyboard.TargetProperty="Phase"
                                             From="0" To="1"
                                             Duration="{DynamicResource Progress.Duration.Slow}"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 不用 Viewbox：Painter 按 ActualWidth/Height 自适应，省掉逐帧缩放重采样 -->
            <p:ProgressPainter x:Name="SonarPainter" Grid.Column="0"
                               Pattern="Sonar" Thickness="1.5"
                               Accent="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                               Dim="{DynamicResource Progress.Brush.Track}" />

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 14 · 打字省略号 -->
    <ControlTemplate x:Key="Progress.Template.Typing.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TypingA"
                                                           Storyboard.TargetProperty="Opacity"
                                                           Duration="{DynamicResource Progress.Duration.Base}"
                                                           RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.17" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.48" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.64" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TypingB"
                                                           Storyboard.TargetProperty="Opacity"
                                                           BeginTime="0:0:0.2"
                                                           Duration="{DynamicResource Progress.Duration.Base}"
                                                           RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.17" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.48" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.64" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TypingC"
                                                           Storyboard.TargetProperty="Opacity"
                                                           BeginTime="0:0:0.4"
                                                           Duration="{DynamicResource Progress.Duration.Base}"
                                                           RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.17" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.48" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.64" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Progress.Brush.Ink}"
                           Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
                <StackPanel Orientation="Horizontal" Margin="6,3,0,0" VerticalAlignment="Center">
                    <Ellipse x:Name="TypingA" Width="5" Height="5" Margin="0,0,3,0" Opacity="0"
                             Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Ellipse x:Name="TypingB" Width="5" Height="5" Margin="0,0,3,0" Opacity="0"
                             Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Ellipse x:Name="TypingC" Width="5" Height="5" Opacity="0"
                             Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <!-- 18 · 雷达扫描臂 -->
    <ControlTemplate x:Key="Progress.Template.Radar.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RadarRotate"
                                             Storyboard.TargetProperty="(RotateTransform.Angle)"
                                             From="0" To="360"
                                             Duration="{DynamicResource Progress.Duration.Slow}"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="RunningReduced" />
                    <VisualState x:Name="Success" />
                    <VisualState x:Name="Error" />
                    <VisualState x:Name="Paused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform">
                <Canvas Width="120" Height="120">
                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="116" Height="116"
                             Stroke="{DynamicResource Progress.Brush.Guide}"
                             StrokeThickness="1" />
                    <Ellipse Canvas.Left="27" Canvas.Top="27" Width="66" Height="66"
                             Stroke="{DynamicResource Progress.Brush.Guide}"
                             StrokeThickness="1"
                             StrokeDashArray="2 3" />
                    <Line X1="60" Y1="6" X2="60" Y2="114" Stroke="{DynamicResource Progress.Brush.Guide}" StrokeThickness="1" />
                    <Line X1="6" Y1="60" X2="114" Y2="60" Stroke="{DynamicResource Progress.Brush.Guide}" StrokeThickness="1" />
                    <Grid Width="120" Height="120" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="RadarRotate" />
                        </Grid.RenderTransform>
                        <Path Data="M 60,60 L 60,2 A 58,58 0 0 1 98.8,16.9 Z"
                              Fill="{DynamicResource Progress.Brush.AccentSoft}" />
                        <Path Data="M 60,60 L 98.8,16.9"
                              Stroke="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                              StrokeThickness="1.5" />
                    </Grid>
                    <Ellipse Canvas.Left="56" Canvas.Top="56" Width="8" Height="8"
                             Fill="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource Progress.StatusText}"
                       Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!-- 21 · 呼吸光球：单 Phase 自绘，渐变只冻结一次，不再逐帧缩放重光栅化 -->
    <ControlTemplate x:Key="Progress.Template.Breathing.Indeterminate" TargetType="{x:Type p:ProgressIndicator}">
        <Grid x:Name="PART_Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                    <VisualState x:Name="Idle" />
                    <VisualState x:Name="Running">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="BreathPainter"
                                             Storyboard.TargetProperty="Phase"
                                             From="0" To="1"
                                             Duration="{DynamicResource Progress.Duration.Breath}"
                                             AutoReverse="True"
                                             RepeatBehavior="Forever" />
